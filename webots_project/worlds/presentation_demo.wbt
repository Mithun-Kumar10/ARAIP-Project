#VRML_SIM R2023b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/robots/gctronic/e-puck/protos/E-puck.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/solids/protos/SolidBox.proto"

WorldInfo {
  info [
    "ARAIP Project Part 2 - presentation demo"
    "E-puck planned search for the red, blue and green blocks (OpenCV HSV + pre-filter),"
    "in the same arena as the three Sketchfab models used for the CNN camera test:"
    "bird (Realistic Blue Jay Bird by ItsKrish7), cat (Curious Cat by rt699448),"
    "automobile (Low Poly Car - BMW E30 1985 White by roh3d), all CC BY 4.0 from sketchfab.com"
    "Fixed block layout (no experiment manager) so the demo is the same every time."
  ]
  title "E-puck Block Search + CNN objects (demo)"
  basicTimeStep 32
}
Viewpoint {
  orientation 0 1 0 1.5708
  position 0 0 4.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 2 2
  floorAppearance PBRAppearance {
    baseColor 0 0 0
    roughness 1
    metalness 0
  }
}
DEF RED_BLOCK SolidBox {
  translation 0.56 -0.47 0.05
  rotation 0 0 1 0.42
  name "red block"
  size 0.3 0.3 0.1
  appearance PBRAppearance {
    baseColor 1 0 0
    roughness 1
    metalness 0
  }
}
DEF BLUE_BLOCK SolidBox {
  translation -0.61 0.33 0.05
  rotation 0 0 1 1.1
  name "blue block"
  size 0.3 0.3 0.1
  appearance PBRAppearance {
    baseColor 0 0 1
    roughness 1
    metalness 0
  }
}
DEF GREEN_BLOCK SolidBox {
  translation 0.45 0.5 0.05
  rotation 0 0 1 2.3
  name "green block"
  size 0.3 0.3 0.1
  appearance PBRAppearance {
    baseColor 0 1 0
    roughness 1
    metalness 0
  }
}
# Sketchfab models from the CNN camera test (obstacles only: the colour search ignores them)
DEF BIRD Solid {
  translation 0.75 0.05 0
  rotation 0 0 1 1.5708
  children [
    CadShape {
      url [
        "../models/blue_jay/blue_jay.obj"
      ]
    }
  ]
  name "bird"
  boundingObject Pose {
    translation 0 0 0.085
    children [
      Box {
        size 0.16 0.078 0.169
      }
    ]
  }
}
DEF CAT Solid {
  translation 0.0 0.82 0
  rotation 0 0 1 1.5708
  children [
    CadShape {
      url [
        "../models/cat/cat.obj"
      ]
    }
  ]
  name "cat"
  boundingObject Pose {
    translation 0 0 0.116
    children [
      Box {
        size 0.316 0.4 0.231
      }
    ]
  }
}
DEF CAR Solid {
  translation -0.6 -0.6 0
  rotation 0 0 1 5.4978
  children [
    CadShape {
      url [
        "../models/car/car.obj"
      ]
    }
  ]
  name "car"
  boundingObject Pose {
    translation 0 0 0.086
    children [
      Box {
        size 0.55 0.218 0.173
      }
    ]
  }
}
DEF EPUCK E-puck {
  translation 0 0 0
  controller "epuck_block_search_v2"
}
